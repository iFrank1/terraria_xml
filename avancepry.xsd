<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- ============================== -->
  <!-- Elemento raíz                  -->
  <!-- ============================== -->
  <xs:element name="wiki">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="items" type="ItemsType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ============================== -->
  <!-- Tipo items                     -->
  <!-- ============================== -->
  <xs:complexType name="ItemsType">
    <xs:sequence>
      <xs:element name="herramientas" type="HerramientasType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ============================== -->
  <!-- Tipo herramientas              -->
  <!-- ============================== -->
  <xs:complexType name="HerramientasType">
    <xs:sequence>
      <xs:element name="picos_y_taladros" type="CategoriaType"/>
      <xs:element name="hachas_y_motosierras" type="CategoriaType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ============================== -->
  <!-- Tipo categoría (picos/hachas)  -->
  <!-- ============================== -->
  <xs:complexType name="CategoriaType">
    <xs:sequence>
      <xs:element name="pre-hardmode" type="PreHardmodeType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ============================== -->
  <!-- Tipo pre-hardmode              -->
  <!-- ============================== -->
  <xs:complexType name="PreHardmodeType">
    <xs:sequence>
      <xs:element name="item" type="ItemType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ============================== -->
  <!-- Tipo item                      -->
  <!-- ============================== -->
  <xs:complexType name="ItemType">
    <xs:sequence>
      <xs:element name="estadisticas" type="EstadisticasType"/>
      <xs:element name="creacion" type="CreacionType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="nombre" type="xs:string" use="required"/>
    <xs:attribute name="url" type="xs:anyURI" use="required"/>
    <xs:attribute name="id" type="xs:integer" use="optional"/>
    <xs:attribute name="versiones" type="xs:string" use="optional"/>
    <xs:attribute name="tipo" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- ============================== -->
  <!-- Tipo estadísticas              -->
  <!-- ============================== -->
  <xs:complexType name="EstadisticasType">
    <xs:attribute name="poder_pico" type="xs:string" use="optional"/>
    <xs:attribute name="poder_hacha" type="xs:string" use="optional"/>
    <xs:attribute name="poder_martillo" type="xs:string" use="optional"/>
    <xs:attribute name="danio" type="xs:string" use="optional"/>
    <xs:attribute name="bonus" type="xs:string" use="optional"/>
    <xs:attribute name="tiempo_uso" type="xs:string" use="optional"/>
    <xs:attribute name="velocidad_herramienta" type="xs:string" use="optional"/>
    <xs:attribute name="empuje" type="xs:string" use="optional"/>
    <xs:attribute name="rareza" type="xs:string" use="optional"/>
    <xs:attribute name="venta" type="xs:string" use="optional"/>
    <xs:attribute name="estado" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- ============================== -->
  <!-- Tipo creación                  -->
  <!-- ============================== -->
  <xs:complexType name="CreacionType">
    <xs:sequence>
      <xs:element name="receta" type="RecetaType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="estado" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- ============================== -->
  <!-- Tipo receta                    -->
  <!-- ============================== -->
  <xs:complexType name="RecetaType">
    <xs:sequence>
      <xs:element name="ingrediente" type="IngredienteType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="estacion" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- ============================== -->
  <!-- Tipo ingrediente               -->
  <!-- ============================== -->
  <xs:complexType name="IngredienteType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="cantidad" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

</xs:schema>